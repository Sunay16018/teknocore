  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "launch_handler": {
    "client_mode": ["focus-existing", "navigate-existing", "auto"]
  },
  
  "protocol_handlers": [
    {
      "protocol": "web+teknocore",
      "url": "/teknocore/handle-protocol?type=%s"
    },
    {
      "protocol": "web+teknocore-gallery",
      "url": "/teknocore/gallery?type=%s"
    }
  ],
  
  "share_target": {
    "action": "/teknocore/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "screenshots",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/svg+xml"]
        }
      ]
    }
  },
  
  "file_handlers": [
    {
      "action": "/teknocore/open-file",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/svg+xml": [".svg"]
      },
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  
  "note_taking": {
    "action": "/teknocore/new-note"
  },
  
  "capture_links": "never",
  
  "scope_extensions": [
    {
      "origin": "*.github.io"
    },
    {
      "origin": "sunay16018.github.io"
    }
  ],
  
  "handle_links": "preferred",
  
  "features": [
    "Cross-Platform",
    "Offline Support",
    "File Handling",
    "Share Target",
    "Protocol Handlers",
