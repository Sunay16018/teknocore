    },
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.teknocore",
      "id": "app.teknocore"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/teknocore/id123456789",
      "id": "123456789"
    },
    {
      "platform": "windows",
      "url": "https://www.microsoft.com/store/apps/teknocore",
      "id": "teknocore"
    },
    {
      "platform": "chrome_web_store",
      "url": "https://chrome.google.com/webstore/teknocore",
      "id": "teknocore"
    }
  ],
  
  "display_override": [
    "standalone",
    "fullscreen", 
    "minimal-ui",
    "window-controls-overlay"
  ],
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "launch_handler": {
    "client_mode": ["focus-existing", "navigate-existing", "auto"]
  },
  
  "protocol_handlers": [
    {
      "protocol": "web+teknocore",
      "url": "/handle-protocol?type=%s"
    },
    {
      "protocol": "web+teknocore-gallery",
      "url": "/gallery?type=%s"
    },
    {
      "protocol": "web+teknocore-icon",
      "url": "/icon?name=%s"
    }
  ],
  
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "screenshots",
          "accept": ["image/png", "image/jpeg", "image/webp", "image/svg+xml"]
        },
        {
          "name": "icons",
          "accept": ["image/png", "image/svg+xml"]
        }
      ]
    }
  },
  
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/svg+xml": [".svg"],
        "image/x-icon": [".ico"]
      },
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        },
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "action": "/open-image",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".svg", ".ico"]
      },
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  
  "note_taking": {
    "action": "/new-note"
  },
  
  "capture_links": "never",
  
  "scope_extensions": [
    {
      "origin": "*.teknocore.app"
    },
    {
      "origin": "*.teknocore.com"
    },
    {
      "origin": "*.teknocore.net"
    },
    {
      "origin": "*.teknocore.org"
    },
    {
      "origin": "teknocore.vercel.app"
    }
  ],
  
  "handle_links": "preferred",
  
  "prefer_related_applications": false,
  
  "minimum_chrome_version": "88",
  
  "offline_enabled": true,
  
  "permissions": [
    "storage",
    "notifications",
    "file-handling"
  ],
  
  "features": [
    "Cross-Platform",
    "Offline Support",
    "Push Notifications",
    "File Handling",
    "Share Target",
    "Protocol Handlers",
    "Edge Panel",
    "Window Controls Overlay",
    "Maskable Icons",
    "8K Resolution",
    "Ultra HD",
    "Vector Quality",
    "Premium Design"
  ]
}
